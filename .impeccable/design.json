  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action in the current theme.",
      "html": "<button class=\"ds-button-primary\">Connect</button>",
      "css": ".ds-button-primary {font-family:inherit;font-size:10px;font-weight:550;min-height:34px;padding:9px 12px;border-radius:7px;cursor:pointer;transition:border-color .15s,background .15s;background:var(--primary);color:light-dark(var(--surface),#171d32);border:1px solid var(--primary)}.ds-button-primary:hover{filter:brightness(1.08)}.ds-button-primary:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}.ds-button-primary:disabled{opacity:.48;cursor:default}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered secondary action.",
      "html": "<button class=\"ds-button-secondary\">Pause</button>",
      "css": ".ds-button-secondary {font-family:inherit;font-size:10px;font-weight:550;min-height:34px;padding:9px 12px;border-radius:7px;cursor:pointer;transition:border-color .15s,background .15s;background:var(--surface);color:var(--text);border:1px solid var(--border)}.ds-button-secondary:hover{border-color:var(--primary);color:var(--primary)}.ds-button-secondary:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}.ds-button-secondary:disabled{opacity:.48;cursor:default}"
    },
    {
      "name": "Settings Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Labeled backend name field.",
      "html": "<label class=\"ds-field-label\">Backend name<input class=\"ds-field\" placeholder=\"Local Shadowquic\"></label>",
      "css": ".ds-field-label{display:block;font-family:inherit;font-size:11px;font-weight:500;color:var(--text)}.ds-field{display:block;margin-top:9px;min-height:38px;padding:11px 12px;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:7px;font-family:inherit;font-size:11px}.ds-field::placeholder{color:var(--muted)}.ds-field:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Active and inactive navigation destinations.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-nav-item ds-nav-active\" aria-current=\"page\">Overview</button><button class=\"ds-nav-item\">Connections</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px}.ds-nav-item{display:flex;align-items:center;height:44px;padding:0 14px;background:transparent;border:0;border-radius:8px;color:var(--secondary);font-family:inherit;font-size:12px;text-align:left;cursor:pointer;transition:background .15s,color .15s}.ds-nav-item:hover{background:var(--line);color:var(--text)}.ds-nav-item.ds-nav-active{background:var(--primary-soft);color:var(--primary);font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}"
    },
    {
      "name": "Connection Status",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Connection label with a status dot.",
      "html": "<span class=\"ds-status\"><i class=\"ds-status-dot\" aria-hidden=\"true\"></i>Online</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:5px;font-family:inherit;font-size:8px;font-weight:500;color:var(--green);background:color-mix(in srgb,var(--green) 9%,var(--surface))}.ds-status-dot{width:5px;height:5px;border-radius:50%;background:var(--green)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Shared bordered content container.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Traffic activity</h2><p class=\"ds-panel-caption\">Bandwidth over the last two minutes</p></section>",
      "css": ".ds-panel{padding:20px 21px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:11px;box-shadow:var(--shadow)}.ds-panel-title{margin:0;font-family:inherit;font-size:14px;font-weight:650;letter-spacing:-.15px}.ds-panel-caption{margin:5px 0 0;color:var(--muted);font-family:inherit;font-size:10px;line-height:1.6}"
    },
    {
      "name": "Metric Card",
